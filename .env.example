# Strapi CMS base URL
STRAPI_URL=http://localhost:1337

# Resend email service — get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Address you want contact/apply notifications delivered to
CONTACT_EMAIL=you@yourdomain.com
# Verified sender address (use onboarding@resend.dev while in Resend sandbox)
RESEND_FROM=onboarding@resend.dev
